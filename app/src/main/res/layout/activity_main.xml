<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!--Top Labels-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/statusSection"
        android:layout_width="410dp"
        android:layout_height="60dp"
        android:background="#64DDE5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!--Current Level-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="5dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            >

        <TextView
            android:id="@+id/currentLevel"
            android:text="@string/label_current_level"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />
            <TextView
                android:id="@+id/currentLevelValue"
                android:text="0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginTop="5dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:textSize="23sp"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <!--Goals RemainingLevel-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginBottom="5dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            >
            <TextView
                android:id="@+id/goalsRemaining"
                android:text="@string/label_goals_remaining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />
            <TextView
                android:id="@+id/goalsRemainingValue"
                android:text="0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginTop="5dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:textSize="23sp"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <!--Moves Made-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            >

            <TextView
                android:id="@+id/movesMade"
                android:text="@string/label_moves_made"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />
            <TextView
                android:id="@+id/movesMadeValue"
                android:text="0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginTop="5dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:textSize="23sp"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--The Board-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="45dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/statusSection"
        app:layout_constraintBottom_toBottomOf="@+id/bottomSection"

        android:background="@color/colorBoard"
        >
        <!--ROW 1-->
        <ImageView
            android:id="@+id/cellGrid0"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:srcCompat="@tools:sample/avatars" />
        <ImageView
            android:id="@+id/cellGrid1"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cellGrid0"
            tools:srcCompat="@tools:sample/avatars" />
        <ImageView
            android:id="@+id/cellGrid2"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cellGrid1"
            tools:srcCompat="@tools:sample/avatars" />
        <ImageView
            android:id="@+id/cellGrid3"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cellGrid2"
            tools:srcCompat="@tools:sample/avatars" />

        <!--ROW 2-->
        <ImageView
            android:id="@+id/cellGrid5"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/cellGrid0"
            app:layout_constraintStart_toStartOf="parent"
            tools:srcCompat="@tools:sample/avatars" />
        <ImageView
            android:id="@+id/cellGrid6"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/cellGrid1"
            app:layout_constraintStart_toEndOf="@+id/cellGrid5"
            tools:srcCompat="@tools:sample/avatars" />
        <ImageView
            android:id="@+id/cellGrid7"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/cellGrid2"
            app:layout_constraintStart_toEndOf="@+id/cellGrid6"
            tools:srcCompat="@tools:sample/avatars" />
        <ImageView
            android:id="@+id/cellGrid8"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/cellGrid3"
            app:layout_constraintStart_toEndOf="@+id/cellGrid7"
            tools:srcCompat="@tools:sample/avatars" />

        <!--ROW 3-->
        <ImageView
            android:id="@+id/cellGrid9"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/cellGrid5"
            app:layout_constraintStart_toStartOf="parent"
            tools:srcCompat="@tools:sample/avatars" />
        <ImageView
            android:id="@+id/cellGrid10"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/cellGrid6"
            app:layout_constraintStart_toEndOf="@+id/cellGrid9"
            tools:srcCompat="@tools:sample/avatars" />
        <ImageView
            android:id="@+id/cellGrid11"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/cellGrid7"
            app:layout_constraintStart_toEndOf="@+id/cellGrid10"
            tools:srcCompat="@tools:sample/avatars" />
        <ImageView
            android:id="@+id/cellGrid12"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/cellGrid8"
            app:layout_constraintStart_toEndOf="@+id/cellGrid11"
            tools:srcCompat="@tools:sample/avatars" />

        <!--ROW 4-->
        <ImageView
            android:id="@+id/cellGrid13"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/cellGrid9"
            app:layout_constraintStart_toStartOf="parent"
            tools:srcCompat="@tools:sample/avatars" />
        <ImageView
            android:id="@+id/cellGrid14"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/cellGrid10"
            app:layout_constraintStart_toEndOf="@+id/cellGrid13"
            tools:srcCompat="@tools:sample/avatars" />
        <ImageView
            android:id="@+id/cellGrid15"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/cellGrid11"
            app:layout_constraintStart_toEndOf="@+id/cellGrid14"
            tools:srcCompat="@tools:sample/avatars" />
        <ImageView
            android:id="@+id/cellGrid16"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/cellGrid12"
            app:layout_constraintStart_toEndOf="@+id/cellGrid15"
            tools:srcCompat="@tools:sample/avatars" />

        <!--ROW 5-->
        <ImageView
            android:id="@+id/cellGrid17"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/cellGrid13"
            app:layout_constraintStart_toStartOf="parent"
            tools:srcCompat="@tools:sample/avatars" />
        <ImageView
            android:id="@+id/cellGrid18"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/cellGrid14"
            app:layout_constraintStart_toEndOf="@+id/cellGrid17"
            tools:srcCompat="@tools:sample/avatars" />
        <ImageView
            android:id="@+id/cellGrid19"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/cellGrid15"
            app:layout_constraintStart_toEndOf="@+id/cellGrid14"
            tools:srcCompat="@tools:sample/avatars" />
        <ImageView
            android:id="@+id/cellGrid20"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/cellGrid16"
            app:layout_constraintStart_toEndOf="@+id/cellGrid15"
            tools:srcCompat="@tools:sample/avatars" />

        <!--ROW 6-->
        <ImageView
            android:id="@+id/cellGrid21"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/cellGrid17"
            app:layout_constraintStart_toStartOf="parent"
            tools:srcCompat="@tools:sample/avatars" />
        <ImageView
            android:id="@+id/cellGrid22"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/cellGrid18"
            app:layout_constraintStart_toEndOf="@+id/cellGrid21"
            tools:srcCompat="@tools:sample/avatars" />
        <ImageView
            android:id="@+id/cellGrid23"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/cellGrid19"
            app:layout_constraintStart_toEndOf="@+id/cellGrid22"
            tools:srcCompat="@tools:sample/avatars" />
        <ImageView
            android:id="@+id/cellGrid24"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/cellGrid20"
            app:layout_constraintStart_toEndOf="@+id/cellGrid23"
            tools:srcCompat="@tools:sample/avatars" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--Bottom Labels-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomSection"
        android:layout_width="match_parent"
        android:layout_height="80dp"

        app:layout_constraintHorizontal_bias="0.027"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"

        android:background="@color/colorPrimary"
        >
        <Button
            android:id="@+id/button_start"
            android:layout_width="180dp"
            android:layout_height="50dp"

            android:onClick="showToast"
            android:text="@string/label_button_start"
            android:textColor="@android:color/white"


            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>


